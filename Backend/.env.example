PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://mobzilla:mobzilla@localhost:5433/mobzilla?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Gemini. Do not commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OMDb. Do not commit a real key.
OMDB_API_KEY=

# Optional cloud FFmpeg. Local ffmpeg or Docker is used when this URL is empty.
FFMPEG_API_KEY=
FFMPEG_API_URL=

MAX_UPLOAD_MB=50
MAX_DURATION_SECONDS=180
GEMINI_MAX_FRAMES=4
STORAGE_DIR=storage

# Optional video storage. Local files are deleted after processing when both are unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
